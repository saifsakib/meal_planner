generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["meal_planner","public"]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meals     Meal[]
  role      Role
  @@schema("meal_planner")
}

enum Role {
  ADMIN
  USER
  @@schema("meal_planner")

}

model Meal {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  user_id   Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [user_id], references: [id])
  mealFoods MealFood[]

  @@schema("meal_planner")
}

model MealFood {
  id              Int         @id @default(autoincrement())
  amount          Float
  meal_id         Int
  food_id         Int
  serving_unit_id Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  food            Food        @relation(fields: [food_id], references: [id])
  meal            Meal        @relation(fields: [meal_id], references: [id])
  serving_unit    ServingUnit @relation(fields: [serving_unit_id], references: [id])

  @@schema("meal_planner")
}

model Food {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  fats             Float
  carbohydrates    Float
  suger            Float
  fiber            Float
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  foodServingUnits FoodServingUnit[]
  mealFoods        MealFood[]

  @@schema("meal_planner")
}

model ServingUnit {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  foodServingUnits FoodServingUnit[]
  mealFoods        MealFood[]

  @@schema("meal_planner")
}

model FoodServingUnit {
  id              Int         @id @default(autoincrement())
  grams           Float
  food_id         Int
  serving_unit_id Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  food            Food        @relation(fields: [food_id], references: [id])
  serving_unit    ServingUnit @relation(fields: [serving_unit_id], references: [id])

  @@schema("meal_planner")
}
